    "A resilient houseplant with upright leaves that tolerates a wide range of indoor light conditions." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine robuste Zimmerpflanze mit aufrechten Blättern, die viele unterschiedliche Lichtverhältnisse in Innenräumen verträgt."
          }
        }
      }
    },
    "A trailing houseplant with heart-shaped leaves that adapts well to common indoor environments." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine rankende Zimmerpflanze mit herzförmigen Blättern, die sich gut an typische Bedingungen in Innenräumen anpasst."
          }
        }
      }
    },
    "A tropical houseplant known for its large green leaves and naturally developing leaf openings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tropische Zimmerpflanze, bekannt für ihre großen grünen Blätter und die sich natürlich entwickelnden Blattöffnungen."
          }
        }
      }
    },
